# ==========================================
# Agentic OS — Backend Configuration
# ==========================================

APP_NAME="Agentic OS"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./agentic_os.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_os
DB_ECHO=false

# LLM Providers
LLM_PROVIDER=mock
DEFAULT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Embedding Providers & pgvector
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OLLAMA_BASE_URL=http://localhost:11434

# Safety Policies
DEFAULT_PERMISSION_POLICY=strict
AUTO_APPROVE_LOW_RISK=true
REQUIRE_APPROVAL_MEDIUM_RISK=true
REQUIRE_APPROVAL_HIGH_RISK=true
BLOCK_CRITICAL_RISK=true

# Sandboxing
WORKSPACE_ROOT=./workspaces
MAX_EXECUTION_TIMEOUT_SECONDS=60
MAX_OUTPUT_BYTES=524288
